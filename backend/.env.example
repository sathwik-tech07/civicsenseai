# ==========================================
# CivicSense AI Environment Configuration Template
# ==========================================

# AI Providers (ollama | gemini)
# In development: defaults to local Ollama (llama3.2:1b) for text, and Gemini for vision.
# In production:
#   - If LLM_PROVIDER=gemini, GEMINI_API_KEY is required.
#   - If LLM_PROVIDER=ollama, OLLAMA_BASE_URL must point to a remote managed host (localhost/127.0.0.1 is rejected).
#   - If VISION_PROVIDER=gemini, GEMINI_API_KEY is required.
LLM_PROVIDER=ollama
AI_PROVIDER=ollama
VISION_PROVIDER=gemini

# Ollama Configuration
# Local dev: http://localhost:11434; Production: https://ollama.internal.domain
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_VISION_MODEL=moondream

# Gemini Configuration (required in production for vision and when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API Configuration
# Webhook URL: https://<domain>/api/v1/whatsapp/webhook
# Webhook requires GET challenge verification (WHATSAPP_VERIFY_TOKEN) and POST HMAC-SHA256 verification (META_APP_SECRET).
# Outbound messaging requires Meta Phone Number ID and System User Permanent Access Token.
# In production: if WhatsApp is enabled/configured, all 4 required credentials must be provided:
#   - WHATSAPP_PHONE_NUMBER_ID: Meta Business Phone Number ID for sending messages
#   - WHATSAPP_ACCESS_TOKEN: Cloud API System User Bearer token (never exposed in logs/responses)
#   - WHATSAPP_VERIFY_TOKEN: Secret token configured in Meta App Dashboard for GET webhook verification
#   - META_APP_SECRET: App secret from Meta App Dashboard used to verify POST X-Hub-Signature-256
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Security & JWT Configuration
# In production, set a cryptographically strong SECRET_KEY (e.g. openssl rand -hex 32)
SECRET_KEY=civicsense-ai-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo Accounts Configuration
# In development, defaults to true to enable local testing profiles (password: password123).
# In production, ENABLE_DEMO_ACCOUNTS must be false (validate_production_security enforces this).
ENABLE_DEMO_ACCOUNTS=false

# CORS Configuration (Comma-separated list of allowed frontend origins)
# In development, defaults to Vite/React dev ports: http://localhost:5173,http://127.0.0.1:5173,etc.
# In production, must be explicitly configured without wildcards (* is forbidden in production)
# Example: CORS_ORIGINS=https://civicsense.ai,https://admin.civicsense.ai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Limits (in bytes; default 10MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Persistent Object Storage (local for development, s3 for production)
# In development, STORAGE_PROVIDER=local saves evidence photos to backend/uploads/
# In production, STORAGE_PROVIDER=s3 persists evidence in S3-compatible object storage
STORAGE_PROVIDER=local
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=
# Configurable AWS SigV4 presigned URL expiration in seconds (default 15 minutes = 900 seconds)
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Database URL (defaults to SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/civicsense

# Authentication Rate Limiting & Brute-Force Protection
# Limits failed login attempts per client IP within a sliding window (default: max 10 failed logins per 60s)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Limits signup attempts per client IP within a sliding window (default: max 5 signups per 60s)
RATE_LIMIT_SIGNUP_MAX_ATTEMPTS=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
# Storage backend: 'database' (atomic shared table, recommended for Render multi-instance) or 'redis'
# Note: 'memory' is strictly forbidden in production mode
RATE_LIMIT_BACKEND=database
REDIS_URL=

# Reverse Proxy & Trusted Proxy Configuration
# Keep disabled (false) until actual reverse proxy source/range is confirmed from deployment evidence.
TRUST_PROXY_HEADERS=false
# Comma-separated list of trusted proxy IPs or CIDR blocks.
# Defaults strictly to loopback and testclient.
# Do not trust broad unverified ranges (like 10.0.0.0/8) without confirmed deployment evidence.
TRUSTED_PROXIES=127.0.0.1,::1,testclient
